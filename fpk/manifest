appname               = autopower
version               = 1.3.0
display_name          = 自动开关机
desc                  = 为 NAS 设置定时开机与定时关机计划，支持每天、平日、假日和指定星期。应用以普通权限运行，开关机由管理员通过 SSH 一次性部署的执行器完成：定时开机通过主板 RTC 唤醒实现，定时关机通过系统定时任务实现。
platform              = x86
source                = thirdparty
category              = system
maintainer            = VanJay
maintainer_url        = https://github.com/wangwanjie/FN-AutoPower
distributor           = VanJay
distributor_url       = https://github.com/wangwanjie/FN-AutoPower
desktop_uidir         = ui
desktop_applaunchname = autopower.Application
service_port          = 3868
checkport             = false
ctl_stop              = true
changelog             = 应用改为以普通权限运行，关机与 RTC 唤醒交给独立的 root 执行器：升级后请在应用内打开「执行器部署」，用管理员账号 SSH 执行一次部署命令，部署前不会自动开关机。修复主板时钟与系统时间存在时区差时开机时间不准。新增计划备注、未来 7 天执行预览、计划冲突提示和最近关机记录；时间统一按 NAS 系统时区显示；执行器发现 RTC 闹钟被其他程序改动时自动重写。提供 x86 与 ARM 两个安装包。
