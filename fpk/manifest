appname               = autopower
version               = 1.4.0
display_name          = 自动开关机
desc                  = 为 NAS 设置定时开机、定时关机与定时重启计划，支持每天、平日、假日和指定星期。应用以普通权限运行，开关机由管理员通过 SSH 一次性部署的执行器完成：定时开机通过主板 RTC 唤醒实现，定时关机与重启通过系统定时任务实现。
platform              = x86
source                = thirdparty
category              = system
maintainer            = VanJay
maintainer_url        = https://github.com/wangwanjie/FN-AutoPower
distributor           = VanJay
distributor_url       = https://github.com/wangwanjie/FN-AutoPower
desktop_uidir         = ui
desktop_applaunchname = autopower.Application
service_port          = 3868
checkport             = false
ctl_stop              = true
changelog             = 新增定时重启：计划的操作可选「重启」，支持每天、平日、假日和指定星期。升级后请在应用内打开「执行器部署」，用管理员账号 SSH 重新执行一次部署命令（执行器升级到 1.2.0），未重新部署前重启计划不会执行。同一时间既关机又重启等冲突会给出提示，最近执行记录区分关机与重启。修复全新安装时报错 10237、无法安装的问题。
