category              = system
maintainer            = VanJay
maintainer_url        = https://github.com/wangwanjie/FN-AutoPower
distributor           = VanJay
distributor_url       = https://github.com/wangwanjie/FN-AutoPower
desktop_uidir         = ui
desktop_applaunchname = autopower.Application
service_port          = 3868
checkport             = false
ctl_stop              = true
changelog             = 应用改为以普通权限运行，关机与 RTC 唤醒交给独立的 root 执行器。升级后请在应用内打开「执行器部署」，用管理员账号 SSH 执行一次部署命令，部署前不会自动开关机。
